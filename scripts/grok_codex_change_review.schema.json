{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "execution_authorized",
    "reviewed_commit",
    "risk",
    "summary",
    "blocking_issues",
    "required_checks",
    "approved_command"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["approve", "revise", "reject"]
    },
    "execution_authorized": {"type": "boolean"},
    "reviewed_commit": {"type": "string"},
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "summary": {"type": "string"},
    "blocking_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "required_checks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "approved_command": {"type": ["string", "null"]}
  }
}
