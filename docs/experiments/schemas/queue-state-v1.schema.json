{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:meanaudio:experiment-harness:schema:queue-state:v1",
  "title": "MeanAudio queue state v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_kind", "schema_version", "schema_bundle_id", "queue_id", "updated_at", "entries"],
  "properties": {
    "document_kind": {"const": "queue_state"},
    "schema_version": {"const": "1.0.0"},
    "schema_bundle_id": {"const": "harn-schema-v1"},
    "queue_id": {"$ref": "#/$defs/id"},
    "updated_at": {"type": "string", "format": "date-time"},
    "entries": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "entry_id", "position", "experiment_id", "run_id", "status", "dependencies",
          "assigned_resource", "bindings", "terminal_notification_status"
        ],
        "properties": {
          "entry_id": {"$ref": "#/$defs/id"},
          "position": {"type": "integer", "minimum": 1, "maximum": 10000},
          "experiment_id": {"$ref": "#/$defs/id"},
          "run_id": {"$ref": "#/$defs/id"},
          "status": {"enum": ["blocked", "ready", "active", "held", "completed", "failed", "interrupted"]},
          "dependencies": {
            "type": "array", "maxItems": 1000, "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          },
          "assigned_resource": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object", "additionalProperties": false,
                "required": ["resource_type", "resource_id"],
                "properties": {
                  "resource_type": {"enum": ["gpu", "cpu_pool"]},
                  "resource_id": {"$ref": "#/$defs/id"}
                }
              }
            ]
          },
          "bindings": {
            "type": "object", "additionalProperties": false,
            "required": ["contract_raw_sha256", "preflight_report_raw_sha256", "ledger_raw_sha256", "schema_bundle_sha256"],
            "properties": {
              "contract_raw_sha256": {"$ref": "#/$defs/sha256"},
              "preflight_report_raw_sha256": {"$ref": "#/$defs/sha256"},
              "ledger_raw_sha256": {"$ref": "#/$defs/sha256"},
              "schema_bundle_sha256": {"$ref": "#/$defs/sha256"}
            }
          },
          "terminal_notification_status": {"enum": ["not_applicable", "pending", "delivered"]}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
